{
  "cleanUrls": true,
  "headers": [
    { "source": "/gongitsune.mp3", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/shots/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/og.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/plugins.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/install.sh", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }, { "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
